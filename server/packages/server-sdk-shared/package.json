{
  "name": "@proj-lyra/server-sdk-shared",
  "type": "module",
  "version": "0.14.1",
  "private": true,
  "description": "Eventa contracts for the hosted chat WebSocket",
  "author": {
    "name": "Project LYRA Team",
    "email": "lyra@lyra.local",
    "url": "https://github.com/lyra-org"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lyra-org/lyra.git",
    "directory": "server/packages/server-sdk-shared"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./v2": {
      "types": "./dist/v2.d.mts",
      "default": "./dist/v2.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "scripts": {
    "dev": "pnpm run build",
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@proj-lyra/eventa": "catalog:",
    "valibot": "catalog:"
  }
}
