{
  "name": "@proj-lyra/plugin-sdk",
  "type": "module",
  "version": "0.14.1",
  "private": true,
  "description": "Plugin SDK for Project LYRA",
  "author": {
    "name": "Project LYRA Team",
    "email": "lyra@lyra.local",
    "url": "https://github.com/lyra-org"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lyra-org/lyra.git",
    "directory": "packages/plugin-sdk"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./plugin-host": {
      "types": "./dist/plugin-host/index.d.mts",
      "node": "./dist/plugin-host/runtimes/node/index.mjs",
      "default": "./dist/plugin-host/runtimes/web/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "scripts": {
    "test:run": "vitest run --config vitest.config.ts",
    "build": "tsdown",
    "dev": "pnpm run build",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@proj-lyra/eventa": "catalog:",
    "@proj-lyra/plugin-protocol": "workspace:*",
    "@proj-lyra/std": "catalog:",
    "nanoid": "catalog:",
    "semver": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@types/semver": "catalog:",
    "es-toolkit": "catalog:"
  }
}
