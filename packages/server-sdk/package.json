{
  "name": "@proj-lyra/server-sdk",
  "type": "module",
  "version": "0.14.1",
  "description": "Client-side SDK implementation for connecting to LYRA server components and runtimes",
  "author": {
    "name": "Project LYRA Team",
    "email": "lyra@lyra.local",
    "url": "https://github.com/lyra-org"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lyra-org/lyra.git",
    "directory": "packages/server-sdk"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./utils/node": {
      "types": "./dist/utils/node/index.d.mts",
      "default": "./dist/utils/node/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "scripts": {
    "test:run": "vitest run --config vitest.config.ts",
    "dev": "pnpm run build",
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@proj-lyra/better-ws": "workspace:^",
    "@proj-lyra/server-shared": "workspace:^",
    "@proj-lyra/std": "catalog:",
    "superjson": "catalog:",
    "valibot": "catalog:"
  }
}
