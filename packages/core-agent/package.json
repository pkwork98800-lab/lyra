{
  "name": "@proj-lyra/core-agent",
  "type": "module",
  "version": "0.14.1",
  "private": true,
  "description": "Core agent runtime orchestration for LYRA",
  "author": {
    "name": "Project LYRA Team",
    "email": "lyra@lyra.local",
    "url": "https://github.com/lyra-org"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lyra-org/lyra.git",
    "directory": "packages/core-agent"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./agents/spark-notify": {
      "types": "./dist/agents/spark-notify/index.d.mts",
      "default": "./dist/agents/spark-notify/index.mjs"
    },
    "./agents/spark-command": {
      "types": "./dist/agents/spark-command/index.d.mts",
      "default": "./dist/agents/spark-command/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "scripts": {
    "test:run": "vitest run --config vitest.config.ts",
    "build": "tsdown",
    "eval:run": "vieval run --config ./vieval.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@proj-lyra/eventa": "catalog:",
    "@proj-lyra/mathjson": "workspace:^",
    "@proj-lyra/pipelines-audio": "workspace:^",
    "@proj-lyra/plugin-protocol": "workspace:^",
    "@proj-lyra/provider-inference": "workspace:^",
    "@proj-lyra/server-sdk": "workspace:^",
    "@proj-lyra/server-shared": "workspace:^",
    "@proj-lyra/speech-transformer-chem": "workspace:^",
    "@proj-lyra/speech-transformer-math": "workspace:^",
    "@proj-lyra/std": "catalog:",
    "@proj-lyra/stream-kit": "workspace:^",
    "@xsai-ext/providers": "catalog:",
    "@xsai-ext/responses": "catalog:",
    "@xsai/generate-speech": "catalog:",
    "@xsai/generate-text": "catalog:",
    "@xsai/model": "catalog:",
    "@xsai/shared": "catalog:",
    "@xsai/shared-chat": "catalog:",
    "@xsai/stream-text": "catalog:",
    "@xsai/tool": "catalog:",
    "nanoid": "catalog:",
    "rehype-parse": "catalog:",
    "rehype-stringify": "catalog:",
    "remark-math": "catalog:",
    "remark-parse": "catalog:",
    "unified": "catalog:",
    "unist-util-visit": "catalog:",
    "vieval": "catalog:",
    "xsschema": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/hast": "catalog:",
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "@types/unist": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
