{
  "name": "@proj-lyra/server-runtime",
  "type": "module",
  "version": "0.14.1",
  "description": "Server runtime implementation for LYRA running in different environments",
  "author": {
    "name": "Project LYRA Team",
    "email": "lyra@lyra.local",
    "url": "https://github.com/lyra-org"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lyra-org/lyra.git",
    "directory": "packages/server-runtime"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "default": "./dist/server.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": "./dist/bin/run.mjs",
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "scripts": {
    "test:run": "vitest run --config vitest.config.ts",
    "dev": "tsx ./src/bin/run.js",
    "start": "tsx ./src/bin/run.js",
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@guiiai/logg": "catalog:",
    "@proj-lyra/better-ws": "workspace:^",
    "@proj-lyra/server-shared": "workspace:^",
    "@proj-lyra/std": "catalog:",
    "crossws": "catalog:",
    "h3": "catalog:",
    "nanoid": "catalog:",
    "srvx": "catalog:",
    "superjson": "catalog:",
    "valibot": "catalog:"
  }
}
