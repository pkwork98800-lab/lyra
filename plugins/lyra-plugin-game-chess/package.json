{
  "name": "@proj-lyra/lyra-plugin-game-chess",
  "type": "module",
  "version": "0.14.1",
  "private": true,
  "description": "Chess plugin for LYRA gamelet/widget runtime",
  "scripts": {
    "dev:ui": "vite --host 127.0.0.1 --port 5174",
    "test": "vitest run --root . --config vitest.config.ts",
    "eval:run": "vieval run --root . --config ./vieval.config.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build": "vite build && tsdown"
  },
  "dependencies": {
    "@proj-lyra/eventa": "catalog:",
    "@proj-lyra/plugin-protocol": "workspace:*",
    "@proj-lyra/plugin-sdk": "workspace:*",
    "@proj-lyra/plugin-sdk-tamagotchi": "workspace:*",
    "@proj-lyra/std": "catalog:",
    "@proj-lyra/ui": "workspace:^",
    "animejs": "catalog:",
    "chess.js": "catalog:",
    "reka-ui": "catalog:",
    "stockfish": "catalog:",
    "valibot": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@ax-llm/ax": "catalog:",
    "@proj-lyra/core-agent": "workspace:^",
    "@proj-lyra/stage-ui": "workspace:^",
    "@proj-lyra/unocss-preset-chromatic": "catalog:",
    "@unocss/reset": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@xsai-ext/providers": "catalog:",
    "@xsai/generate-text": "catalog:",
    "@xsai/shared-chat": "catalog:",
    "@xsai/stream-text": "catalog:",
    "pinia": "catalog:",
    "unocss": "catalog:",
    "vieval": "catalog:",
    "xsschema": "catalog:"
  }
